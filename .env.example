# Пример конфига для scripts/cloudns-glue.sh.
# Скопируйте в .env, заполните своими значениями.

# Главный API-пользователь (Settings → API в панели ClouDNS)
CLOUDNS_AUTH_ID=
# Альтернативно — sub-user (если выдан ограниченный доступ):
# CLOUDNS_SUB_AUTH_ID=

# Пароль API-пользователя — отдельный от login-пароля. Сгенерировать
# через иконку «ключ» рядом с auth-id'ом в Settings → API → Users.
CLOUDNS_AUTH_PASSWORD=

# Корневая зона (родительский домен)
CLOUDNS_DOMAIN=
